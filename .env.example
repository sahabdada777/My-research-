# Keep real secrets in Render Environment settings, never in GitHub.
GROQ_API_KEY=replace_with_your_private_key
GROQ_MODEL=openai/gpt-oss-120b

# Optional task-specific model routes. Initially they may all use the same model.
MODEL_WRITING=openai/gpt-oss-120b
MODEL_REASONING=openai/gpt-oss-120b
MODEL_LITERATURE=openai/gpt-oss-120b
MODEL_DATA=openai/gpt-oss-120b
MODEL_REVIEW=openai/gpt-oss-120b
MODEL_VERIFICATION=openai/gpt-oss-120b
MODEL_FAST=openai/gpt-oss-120b

# For local development only. Set your actual frontend origin when deploying.
CORS_ORIGINS=*
